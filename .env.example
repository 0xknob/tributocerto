# Copie para `.env` no servidor de produção (o compose lê automaticamente).
# Local (dev) não precisa deste arquivo: sem as variáveis, os serviços são
# buildados a partir de upstream/.

# Domínio público (ativa HTTPS automático via Let's Encrypt no Caddy).
# Local não definir (Caddy serve HTTP na :80).
SITE_ADDRESS=seudominio.com.br

# Imagens publicadas pelo workflow sync-upstream (repo público = pull sem login).
# `latest` acompanha o último build aprovado; para pinar uma versão, use a tag
# do SHA registrada em .upstream-versions.json.
REGIME_IMAGE=ghcr.io/SEU-USUARIO/tributocerto/regime-regular:latest
SIMPLES_IMAGE=ghcr.io/SEU-USUARIO/tributocerto/simples-nacional:latest
DANFSE_IMAGE=ghcr.io/SEU-USUARIO/tributocerto/danfse:latest
